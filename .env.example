# Tesseract environment variables — all optional.
# Nothing in this repository loads .env files automatically: export these in
# your shell (or process manager) before running experiments or the backend.

# Directory holding experiment artifacts. Default: <repo>/runs.
# Read by experiments, scripts and the dashboard backend.
# TESSERACT_RUNS_DIR=/absolute/path/to/runs

# Comma-separated origins allowed to call the dashboard API.
# Default: http://localhost:5173,http://127.0.0.1:5173
# TESSERACT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
